{
  "name": "ledgerleaf",
  "version": "1.1.1",
  "description": "Personal budgeting with real-time encrypted sync",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/copy-ocr.mjs && vite",
    "build": "node scripts/copy-ocr.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64",
    "android": "npm run build && cap sync android && cd android && ./gradlew assembleDebug",
    "relay": "node server/relay.mjs"
  },
  "author": "Ledgerleaf",
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "ws": "^8.23.0"
  },
  "productName": "Ledgerleaf",
  "private": true,
  "type": "module",
  "build": {
    "appId": "app.ledgerleaf.budget",
    "productName": "Ledgerleaf",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "Ledgerleaf-${version}-windows-portable.exe"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.finance",
      "identity": null,
      "artifactName": "Ledgerleaf-${version}-mac-${arch}.zip"
    },
    "publish": null
  }
}